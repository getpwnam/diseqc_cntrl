{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getpwnam.github.io/diseqc_cntrl/schema/v1/config.schema.json",
  "title": "Cubley Effective Config v1",
  "type": "object",
  "required": [
    "schema",
    "config"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "cubley/v1/config"
    },
    "config": {
      "type": "object",
      "required": [
        "network.enabled",
        "network.hostname",
        "network.mac",
        "network.ipv4.mode",
        "network.ipv4.address",
        "network.ipv4.prefix_length",
        "network.ipv4.gateway",
        "network.ipv4.dns_mode",
        "network.ipv4.dns_servers",
        "mqtt.enabled",
        "mqtt.broker",
        "mqtt.port",
        "mqtt.client_id",
        "mqtt.username",
        "mqtt.password",
        "mqtt.topic_prefix",
        "system.device_name",
        "system.location"
      ],
      "properties": {
        "network.enabled": {
          "type": "boolean",
          "default": true
        },
        "network.hostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63
        },
        "network.mac": {
          "type": "string"
        },
        "network.ipv4.mode": {
          "type": "string",
          "enum": [
            "dhcp",
            "static"
          ],
          "default": "dhcp"
        },
        "network.ipv4.address": {
          "type": "string"
        },
        "network.ipv4.prefix_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "network.ipv4.gateway": {
          "type": "string"
        },
        "network.ipv4.dns_mode": {
          "type": "string",
          "enum": [
            "auto",
            "static"
          ],
          "default": "auto"
        },
        "network.ipv4.dns_servers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 2
        },
        "mqtt.enabled": {
          "type": "boolean",
          "default": false
        },
        "mqtt.broker": {
          "type": "string"
        },
        "mqtt.port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "mqtt.client_id": {
          "type": "string"
        },
        "mqtt.username": {
          "type": "string"
        },
        "mqtt.password": {
          "type": "string"
        },
        "mqtt.topic_prefix": {
          "type": "string"
        },
        "system.device_name": {
          "type": "string"
        },
        "system.location": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}