{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getpwnam.github.io/diseqc_cntrl/schema/v1/config.schema.json",
  "title": "Cubley Effective Config v1",
  "type": "object",
  "required": [
    "schema",
    "config"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "cubley/v1/config"
    },
    "config": {
      "type": "object",
      "required": [
        "network.static_ip",
        "network.static_subnet",
        "network.static_gateway",
        "mqtt.broker",
        "mqtt.port",
        "mqtt.client_id",
        "mqtt.username",
        "mqtt.password",
        "mqtt.topic_prefix",
        "mqtt.transport_mode",
        "system.device_name",
        "system.location"
      ],
      "properties": {
        "network.static_ip": {
          "type": "string"
        },
        "network.static_subnet": {
          "type": "string"
        },
        "network.static_gateway": {
          "type": "string"
        },
        "mqtt.broker": {
          "type": "string"
        },
        "mqtt.port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "mqtt.client_id": {
          "type": "string"
        },
        "mqtt.username": {
          "type": "string"
        },
        "mqtt.password": {
          "type": "string"
        },
        "mqtt.topic_prefix": {
          "type": "string"
        },
        "mqtt.transport_mode": {
          "type": "string",
          "enum": [
            "system-net",
            "w5500-native"
          ]
        },
        "system.device_name": {
          "type": "string"
        },
        "system.location": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}