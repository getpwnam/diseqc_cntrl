{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getpwnam.github.io/diseqc_cntrl/schema/v1/state.schema.json",
  "title": "Cubley Runtime State v1",
  "type": "object",
  "required": [
    "schema",
    "availability",
    "busy",
    "rotor",
    "lnb",
    "config",
    "error"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "cubley/v1/state"
    },
    "availability": {
      "$ref": "common.schema.json#/$defs/availability"
    },
    "busy": {
      "type": "boolean"
    },
    "rotor": {
      "type": "object",
      "required": [
        "state",
        "position"
      ],
      "properties": {
        "state": {
          "$ref": "common.schema.json#/$defs/rotorState"
        },
        "position": {
          "type": "object",
          "required": [
            "angle_deg",
            "satellite"
          ],
          "properties": {
            "angle_deg": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "satellite": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "lnb": {
      "type": "object",
      "required": [
        "voltage",
        "polarization",
        "tone",
        "band"
      ],
      "properties": {
        "voltage": {
          "$ref": "common.schema.json#/$defs/voltage"
        },
        "polarization": {
          "$ref": "common.schema.json#/$defs/polarization"
        },
        "tone": {
          "$ref": "common.schema.json#/$defs/tone"
        },
        "band": {
          "$ref": "common.schema.json#/$defs/band"
        }
      },
      "additionalProperties": true
    },
    "config": {
      "type": "object",
      "required": [
        "saved",
        "persisted",
        "reload_source",
        "updated_key"
      ],
      "properties": {
        "saved": {
          "type": "boolean"
        },
        "persisted": {
          "type": "boolean"
        },
        "reload_source": {
          "type": "string",
          "enum": [
            "fram",
            "ram"
          ]
        },
        "updated_key": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        }
      },
      "additionalProperties": true
    },
    "error": {
      "type": "string",
      "maxLength": 256
    }
  },
  "additionalProperties": true
}