{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getpwnam.github.io/diseqc_cntrl/schema/v1/result-envelope.schema.json",
  "title": "Cubley Command Result Envelope v1",
  "type": "object",
  "required": [
    "ok",
    "code",
    "msg",
    "ts"
  ],
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "code": {
      "$ref": "common.schema.json#/$defs/resultCode"
    },
    "msg": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "ts": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "req_id": {
      "$ref": "common.schema.json#/$defs/reqId"
    },
    "command": {
      "$ref": "common.schema.json#/$defs/commandId"
    },
    "domain": {
      "$ref": "common.schema.json#/$defs/domain"
    },
    "data": {
      "description": "Command-specific payload. Unknown payloads are allowed for forward compatibility.",
      "oneOf": [
        {
          "$ref": "ack.schema.json"
        },
        {
          "$ref": "state.schema.json"
        },
        {
          "$ref": "config.schema.json"
        },
        {
          "$ref": "capabilities.schema.json"
        },
        {
          "$ref": "version.schema.json"
        },
        {
          "$ref": "lnbh26.schema.json"
        },
        {
          "type": "object",
          "additionalProperties": true
        }
      ]
    }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "properties": {
          "code": {
            "const": "ok"
          }
        }
      }
    }
  ]
}