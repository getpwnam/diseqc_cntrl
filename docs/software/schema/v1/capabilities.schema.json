{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getpwnam.github.io/diseqc_cntrl/schema/v1/capabilities.schema.json",
  "title": "Cubley Capabilities v1",
  "type": "object",
  "required": [
    "schema",
    "capabilities"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "cubley/v1/capabilities"
    },
    "capabilities": {
      "type": "object",
      "required": [
        "domain.diseqc",
        "domain.system",
        "domain.azel",
        "transport.serial",
        "transport.mqtt",
        "feature.status_bar",
        "feature.config_fram"
      ],
      "properties": {
        "domain.diseqc": {
          "type": "boolean"
        },
        "domain.system": {
          "type": "boolean"
        },
        "domain.azel": {
          "type": "boolean"
        },
        "transport.serial": {
          "type": "boolean"
        },
        "transport.mqtt": {
          "type": "boolean"
        },
        "feature.status_bar": {
          "type": "boolean"
        },
        "feature.config_fram": {
          "type": "boolean"
        }
      },
      "additionalProperties": {
        "type": "boolean"
      }
    }
  },
  "additionalProperties": true
}